{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@obelum/core": ["../packages/core/src/index.ts"],
      "@obelum/translator-claude": ["../packages/translator-claude/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
