{
  "name": "@obelum/core",
  "version": "0.1.0",
  "description": "Vector-clock sync tracking for translated documents: staleness, anchored diffs, and a lazy history cursor",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxmart/obelum.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/maxmart/obelum#readme",
  "bugs": "https://github.com/maxmart/obelum/issues",
  "keywords": [
    "i18n",
    "translation",
    "vector-clock",
    "diff",
    "sync",
    "localization"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
